{#
/**
 * @file
 * Evolve html wrapper: keeps the D7 body classes the CSS relies on.
 */
#}
<!DOCTYPE html>
<html{{ html_attributes }}>
  <head>
    <head-placeholder token="{{ placeholder_token }}">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1">
    <title>{{ head_title|safe_join(' | ') }}</title>
    <css-placeholder token="{{ placeholder_token }}">
    <js-placeholder token="{{ placeholder_token }}">
  </head>
  <body{{ attributes.addClass('html', 'ltr', 'wide', 'bg1', 'preset-preset1') }}>
    <div id="skip-link">
      <a href="#main-content" class="visually-hidden focusable element-invisible element-focusable">{{ 'Skip to main content'|t }}</a>
    </div>
    {{ page_top }}
    {{ page }}
    {{ page_bottom }}
    <js-bottom-placeholder token="{{ placeholder_token }}">
  </body>
</html>

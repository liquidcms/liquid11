{#
/**
 * @file
 * "Post medium" teaser shared by articles and portfolio items (D7 node--article--teaser.tpl.php).
 *
 * teaser_image is set in evolve_preprocess_node().
 */
#}
<div{{ attributes.addClass('node', 'node-' ~ node.bundle|clean_class, node.isPromoted ? 'node-promoted', 'node-teaser', 'view-mode-teaser', 'clearfix', 'post', 'medium').setAttribute('id', 'node-' ~ node.id).setAttribute('style', 'margin-top:30px;') }}>
  <div class="row">
    <div class="col-lg-5 col-xl-5 col-12 col-md-12">
      <div class="post-img media">
        <div class="mediaholder">
          <section class="date">
            <span class="day">{{ node.createdtime|format_date('custom', 'd') }}</span>
            <span class="month">{{ node.createdtime|format_date('custom', 'M') }}</span>
          </section>
          {{ teaser_image }}
          <div class="mediahover"></div>
          <div class="portfolio-image-zoom">
            <a href="{{ url }}"><span class="fa fa-link"></span></a>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-7 col-xl-7 col-12 col-md-12">
      <section class="post-content">
        <header class="meta">
          <ul>
            <li><a href="#">{{ 'Posted by'|t }} <span class="username">{{ author_display_name }}</span></a></li>
            <li>{{ content.field_categories }}</li>
            <li><a href="#">0 {{ 'Comments'|t }}</a></li>
          </ul>
          <h2><a href="{{ url }}">{{ label }}</a></h2>
        </header>
        {{ content|without('field_categories', 'field_portfolio_images', 'links') }}
        <a class="button line-color" href="{{ url }}">{{ 'Read More'|t }}</a>
      </section>
    </div>
  </div>
</div>

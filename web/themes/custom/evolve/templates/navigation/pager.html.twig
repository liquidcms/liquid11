{#
/**
 * @file
 * Pager as Bootstrap 5 pagination, keeping the D7 pager-* classes.
 */
#}
{% if items %}
  <h2 class="visually-hidden">{{ 'Pages'|t }}</h2>
  <div class="item-list">
    <ul class="pagination">
      {% if items.first %}
        <li class="page-item pager-first first"><a class="page-link" title="{{ 'Go to first page'|t }}" href="{{ items.first.href }}">{{ '« first'|t }}</a></li>
      {% endif %}
      {% if items.previous %}
        <li class="page-item pager-previous"><a class="page-link" title="{{ 'Go to previous page'|t }}" href="{{ items.previous.href }}">{{ '‹ previous'|t }}</a></li>
      {% endif %}
      {% if ellipses.previous %}<li class="page-item disabled pager-ellipsis"><span class="page-link">…</span></li>{% endif %}
      {% for key, item in items.pages %}
        {% if current == key %}
          <li class="page-item active pager-current{{ loop.first and not items.first ? ' first' }}"><a class="page-link" href="#" title="{{ 'Current page'|t }}" aria-current="page">{{ key }}</a></li>
        {% else %}
          <li class="page-item pager-item"><a class="page-link" title="{{ 'Go to page @key'|t({'@key': key}) }}" href="{{ item.href }}">{{ key }}</a></li>
        {% endif %}
      {% endfor %}
      {% if ellipses.next %}<li class="page-item disabled pager-ellipsis"><span class="page-link">…</span></li>{% endif %}
      {% if items.next %}
        <li class="page-item pager-next"><a class="page-link" title="{{ 'Go to next page'|t }}" href="{{ items.next.href }}">{{ 'next ›'|t }}</a></li>
      {% endif %}
      {% if items.last %}
        <li class="page-item pager-last last"><a class="page-link" title="{{ 'Go to last page'|t }}" href="{{ items.last.href }}">{{ 'last »'|t }}</a></li>
      {% endif %}
    </ul>
  </div>
{% endif %}

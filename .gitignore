# --- Composer-built (restore with `ddev composer install`) ---
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/
/drush/Commands/contrib/

# --- Drupal scaffold files (regenerated by drupal/core-composer-scaffold) ---
/web/.csslintrc
/web/.eslintignore
/web/.eslintrc.json
/web/.ht.router.php
/web/.htaccess
/web/INSTALL.txt
/web/README.md
/web/autoload.php
/web/autoload_runtime.php
/web/example.gitignore
/web/index.php
/web/robots.txt
/web/update.php
/web/modules/README.txt
/web/themes/README.txt
/web/profiles/README.txt
/web/sites/README.txt
/web/sites/development.services.yml
/web/sites/example.settings.local.php
/web/sites/example.sites.php
/web/sites/default/default.services.yml
/web/sites/default/default.settings.php
/.editorconfig
/.gitattributes
/recipes/README.txt

# --- Site-specific / secrets ---
/web/sites/*/files/
/web/sites/*/private/
/web/sites/*/settings.local.php
/web/sites/*/settings.ddev.php
/web/sites/*/services.local.yml

# --- DB dumps and migration scratch ---
*.sql
*.sql.gz
*.zst
/migrate-status.csv
/msg-*.csv

# --- IDE / OS ---
/.idea/
.vscode/
.DS_Store
Thumbs.db
